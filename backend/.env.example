# Backend env file. The server now reads backend/.env first.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/cncpulse
JWT_SECRET=change-me
AI_SERVICE_KEY=change-me

# Optional Windows folder watcher for dossiers
DOSSIER_WATCH_DIR=C:\data CNC CONCEPT

MAINTENANCE_REPORT_COOLDOWN_MIN=15
SENSOR_ALERT_COOLDOWN_SEC=20
PASSWORD_RESET_TTL_MINUTES=15
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_DEBUG_CODE=0

# Optional mail settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=
