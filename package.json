{
  "name": "cnc-pulse-dashboard",
  "author": "Mahdi Tounsi",
  "version": "0.1.0",
  "description": "CNC Pulse Dashboard",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "vite",
    "dev:backend": "node backend/server.js",
    "dev:desktop": "node scripts/desktop-dev.cjs",
    "frontend:dev": "npm run dev:web",
    "build": "npm run build:web",
    "build:web": "vite build",
    "build:desktop": "npm run build:web && electron-builder",
    "preview": "vite preview",
    "preview:web": "vite preview",
    "lint": "eslint .",
    "start": "npm run start:web",
    "start:web": "node backend/server.js",
    "start:backend": "node backend/server.js",
    "backend:start": "npm run start:backend",
    "electron": "electron .",
    "desktop:dev": "npm run dev:desktop",
    "install:backend": "npm install --prefix backend",
    "dist": "npm run build:desktop"
  },
 "build": {
  "appId": "com.cncpulse.dashboard",
  "productName": "CNC Pulse Dashboard",
  "asar": true,
  "compression": "store",
  "files": [
    "dist/**/*",
    "backend/**/*",
    "main.cjs",
    "package.json",
    "!backend/server.out.log",
    "!backend/server.err.log",
    "!backend/uploads/**/*"
  ],
  "directories": {
    "output": "dist-electron"
  },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.3",
    "recharts": "^3.7.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.27",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.3"
  }
}
